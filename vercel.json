{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/src/html", "destination": "/src/html/dashboard.html" },
    { "source": "/src/html/", "destination": "/src/html/dashboard.html" },
    { "source": "/src/html/index.html", "destination": "/src/html/dashboard.html" },
    { "source": "/dashboard", "destination": "/src/html/dashboard.html" },
    { "source": "/crm", "destination": "/src/html/dashboard.html" },
    { "source": "/leads", "destination": "/src/html/leads.html" },
    { "source": "/kanban", "destination": "/src/html/kanban.html" },
    { "source": "/automacoes", "destination": "/src/html/automacoes.html" },
    { "source": "/capturas", "destination": "/src/html/capturas.html" },
    { "source": "/relatorios", "destination": "/src/html/relatorios.html" },
    { "source": "/whitelabel", "destination": "/src/html/configuracoes-whitelabel.html" },
    { "source": "/perfil", "destination": "/src/html/perfil.html" },
    { "source": "/admin", "destination": "/src/html/admin-tenants.html" },
    { "source": "/login", "destination": "/src/html/login.html" }
  ]
}

