{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/login", "dest": "/src/html/login.html" },
    { "src": "/admin-tenants", "dest": "/src/html/admin-tenants.html" },
    { "src": "/leads", "dest": "/src/html/leads.html" },
    { "src": "/kanban", "dest": "/src/html/kanban.html" },
    { "src": "/automacoes", "dest": "/src/html/automacoes.html" },
    { "src": "/capturas", "dest": "/src/html/capturas.html" },
    { "src": "/relatorios", "dest": "/src/html/relatorios.html" },
    { "src": "/configuracoes-whitelabel", "dest": "/src/html/configuracoes-whitelabel.html" },
    { "src": "/perfil", "dest": "/src/html/perfil.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
